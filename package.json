{
  "name": "muhasebbe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "supabase:kur": "node --env-file=.env scripts/supabase-kur.mjs",
    "telegram:kur": "node --env-file=.env scripts/telegram-kur.mjs",
    "telegram:oturum": "node --env-file=.env scripts/telegram-oturum.mjs",
    "telegram:daemon": "node --env-file=.env --import ./scripts/ts-kayit.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/telegram-daemon.ts",
    "push:kur": "node scripts/push-kur.mjs",
    "ts": "node --env-file=.env --import ./scripts/ts-kayit.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "ai:test-on": "node --env-file=.env --import ./scripts/ts-kayit.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-test-on.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.110.8",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.11",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "telegram": "^2.26.22",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
