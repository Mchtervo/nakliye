generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Firma {
  id        Int      @id @default(autoincrement())
  ad        String   @unique
  telefon   String?
  vergiNo   String?
  createdAt DateTime @default(now())
  yukler    Yuk[]
}

// Tüm para alanları KURUŞ cinsinden tam sayıdır (1 TL = 100 kuruş).
model Yuk {
  id          Int      @id @default(autoincrement())
  tarih       DateTime
  firmaId     Int
  firma       Firma    @relation(fields: [firmaId], references: [id])
  nereden     String
  nereye      String
  aciklama    String?
  kdvli       Boolean  @default(true)
  kdvDahilMi  Boolean  @default(true)
  netTutar    Int
  kdvTutar    Int
  toplamTutar Int
  odemeDurumu String   @default("BEKLIYOR") // BEKLIYOR | KISMI | ODENDI
  odemeler    Odeme[]
  createdAt   DateTime @default(now())
}

model Odeme {
  id    Int      @id @default(autoincrement())
  yukId Int
  yuk   Yuk      @relation(fields: [yukId], references: [id], onDelete: Cascade)
  tarih DateTime
  tutar Int
  not   String?
}

model Gider {
  id             Int       @id @default(autoincrement())
  tarih          DateTime
  kategori       String
  aciklama       String?
  kdvli          Boolean   @default(true)
  kdvDahilMi     Boolean   @default(true)
  netTutar       Int
  kdvTutar       Int
  toplamTutar    Int
  fisResmi       String? // local /uploads/... veya Supabase public URL
  gonderildi     Boolean   @default(false)
  gonderimTarihi DateTime?
  litre          Float?
  km             Int?
  createdAt      DateTime  @default(now())
}

model Ayar {
  anahtar String @id
  deger   String
}

// Kasa: nakit / eldeki para hareketleri (manuel giriş-çıkış)
model KasaHareket {
  id        Int      @id @default(autoincrement())
  tarih     DateTime
  tip       String // GIRIS | CIKIS
  tutar     Int // kuruş (her zaman pozitif; yön tip'te)
  aciklama  String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AI modülleri. Mevcut tablolara dokunmaz; hepsi bağımsız çalışır.
// ---------------------------------------------------------------------------

/// Yük ilanlarının toplandığı kaynak (Telegram grubu, web sayfası, AI araması)
model IlanKaynagi {
  id          Int        @id @default(autoincrement())
  tur         String // TELEGRAM | TELEGRAM_UYE | WEB | AI_ARAMA
  ad          String
  hedef       String // chatId | URL | arama sorgusu
  aktif        Boolean   @default(true)
  durum        String    @default("AKTIF") // ADAY | AKTIF | PASIF
  bolge        String? // MARMARA | IC_ANADOLU | ...
  kullaniciAdi String? // TELEGRAM_UYE: @kullaniciadi (elle katılmak için)
  uyeSayisi    Int? // TELEGRAM_UYE: grubun üye sayısı
  sonMesajId   Int? // TELEGRAM_UYE: en son okunan mesaj kimliği
  sonTarama   DateTime?
  sonHata     String?
  bulunanAdet Int        @default(0)
  /** Hasattan gelen ADAY önceliği (yüksek = önce katıl). */
  oncelik     Int        @default(0)
  /** Örn. «Hasat #12 GrupAdı» — nereden bulundu. */
  hasatKaynak String?
  createdAt   DateTime   @default(now())
  ilanlar     YukIlani[]
  hamMesajlar HamMesaj[]

  @@unique([tur, hedef])
  @@index([tur, durum])
  @@index([tur, durum, oncelik])
}

/// Gruplardan çekilen ham mesajlar. AI çözümlemesi kuyruktan yapılır;
/// böylece okuma işi kısa sürer, çözümleme ayrı turda yapılır.
model HamMesaj {
  id             Int          @id @default(autoincrement())
  kaynakId       Int?
  kaynak         IlanKaynagi? @relation(fields: [kaynakId], references: [id], onDelete: Cascade)
  mesajId        Int?
  /** Telegram gönderen kullanıcı id (DM için). */
  gonderenUserId String?
  metin          String
  metinHash      String? // birebir tekrarı AI'a göndermemek için
  onek           String? // aynı listenin tekrarını yakalamak için başlangıç
  islendi        Boolean      @default(false)
  denemeSayisi   Int          @default(0) // AI denemesi; 2'yi geçince kalıcı HATA
  hata           String?
  createdAt      DateTime     @default(now())

  @@unique([kaynakId, mesajId])
  @@index([islendi, denemeSayisi, createdAt])
  @@index([metinHash])
  @@index([kaynakId, onek, createdAt])
  @@index([gonderenUserId])
}

/// Her OpenAI çağrısının token / maliyet kaydı. Ölçemediğimiz şeyi yönetemeyiz.
model AiCagri {
  id              Int      @id @default(autoincrement())
  zaman           DateTime @default(now())
  kaynak          String // ilanCozumle | fisOku | firmaBul | ...
  model           String
  girdiToken      Int      @default(0)
  ciktiToken      Int      @default(0)
  reasoningToken  Int      @default(0)
  maliyetMikro    Int      @default(0) // USD * 1_000_000
  basarili        Boolean  @default(false)
  hata            String?
  sureMs          Int?

  @@index([zaman])
  @@index([kaynak, zaman])
}

/// Rota satırı tekrarı: aynı satır AI'ya bir kez gider.
/// Komisyoncu listeyi 8 kez atınca yeni satır yoksa hiç çağrı yapılmaz.
model SatirHash {
  hash      String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// AI'nin çözümlediği yük ilanı
model YukIlani {
  id            Int          @id @default(autoincrement())
  kaynakId      Int?
  kaynak        IlanKaynagi? @relation(fields: [kaynakId], references: [id], onDelete: SetNull)
  hamMetin      String
  firmaAdi      String?
  ilgiliKisi    String? // kişi adı (firma değil)
  telefon       String?
  nereden       String?
  nereye        String?
  cikisIl       String?
  varisIl       String?
  yuklemeTarihi DateTime?
  ucret         Int? // kuruş — KOMPLE navlun
  fiyatTon      Int? // kuruş — ton başı fiyat ("900+kdv" gibi)
  fiyatBelirsiz Boolean      @default(false) // fiyat var ama türü anlaşılmadı
  tonaj         Int? // ton
  aracTipi      String? // ilanda yazdığı gibi
  aracTipiKod   String? // TENTELI | FRIGO | DAMPER | KAPALI_KASA | LOWBED | SAL_DORSE | KAMYON | DIGER
  yukTipi       String?
  guvenSkoru    Int          @default(0) // 0-100
  durum         String       @default("YENI") // YENI | ILGILENIYOR | ILETISIME_GECILDI | PAZARLIKTA | CEVAP_YOK | ELENDI | YUKE_DONDU | ALINDI | ARSIV
  dedupHash     String       @unique
  donusTalebiId Int?
  donusTalebi   DonusTalebi? @relation(fields: [donusTalebiId], references: [id], onDelete: SetNull)
  bildirildi    Boolean      @default(false)
  /** İlanı atan Telegram kullanıcı id (GramJS DM). */
  gonderenUserId String?
  /** Kaynak gruptaki orijinal Telegram mesaj id. */
  kaynakMesajId Int?
  /** Bu ilanı üreten HamMesaj.id — kalıcı bağ. */
  hamMesajId    Int?
  createdAt     DateTime     @default(now())
  /** Aynı rota tekrar görünce güncellenir (dedup 48s). */
  sonGorulme    DateTime     @default(now())
  telegramDmler TelegramDm[]

  @@index([durum, createdAt])
  @@index([cikisIl, varisIl])
  @@index([telefon, cikisIl, varisIl, sonGorulme])
  @@index([gonderenUserId])
  @@index([hamMesajId])
}

/// Onaylı Telegram DM (otomatik gönderim YOK — kullanıcı [Gönder] basmalı)
model TelegramDm {
  id              Int       @id @default(autoincrement())
  ilanId          Int
  ilan            YukIlani  @relation(fields: [ilanId], references: [id], onDelete: Cascade)
  hedefUserId     String? // Telegram user id
  telefon         String?
  metin           String
  /** ONAY_BEKLIYOR | KUYRUK | GONDERILDI | CEVAP_YOK | ATLANDI | HATA */
  durum           String    @default("ONAY_BEKLIYOR")
  outboundMesajId Int? // gönderilen DM mesaj id (cevap eşlemesi)
  gonderildiAt    DateTime?
  cevapMetin      String?
  cevapAt         DateTime?
  hata            String?
  createdAt       DateTime  @default(now())

  @@index([durum, createdAt])
  @@index([hedefUserId, durum])
  @@index([ilanId])
}

/// Bir yük oluşturulduğunda otomatik açılan dönüş yükü araması
model DonusTalebi {
  id          Int        @id @default(autoincrement())
  yukId       Int?
  cikis       String // dönüşün başlangıcı (orijinal yükün varışı)
  varis       String // dönüşün hedefi (orijinal yükün çıkışı)
  cikisIl     String
  varisIl     String
  aktif       Boolean    @default(true)
  sonKontrol  DateTime?
  eslesmeAdet Int        @default(0)
  createdAt   DateTime   @default(now())
  ilanlar     YukIlani[]

  @@index([aktif])
}

/// AI'nin bulduğu potansiyel müşteri
model AdayFirma {
  id        Int      @id @default(autoincrement())
  ad        String
  sehir     String?
  ilce      String?
  adres     String?
  telefon   String?
  web       String?
  sektor    String?
  kaynak    String? // arama sorgusu / site
  neden     String? // AI'nin niye önerdiği
  skor      Int      @default(0) // 0-100
  durum     String   @default("YENI") // YENI | ARANDI | MUSTERI | ELENDI
  notlar    String?
  createdAt DateTime @default(now())

  @@unique([ad, sehir])
  @@index([durum, skor])
}

/// Günlük AI analiz raporu
model AiAnaliz {
  id        Int      @id @default(autoincrement())
  tarih     DateTime
  tur       String   @default("GUNLUK")
  baslik    String
  metin     String
  veriJson  String? // hesaplanan metrikler (JSON)
  createdAt DateTime @default(now())

  @@unique([tarih, tur])
}

/// Gönderilen bildirimlerin kaydı (tekrarı önlemek ve hata takibi için)
model Bildirim {
  id        Int      @id @default(autoincrement())
  kanal     String // TELEGRAM | PUSH
  hedef     String
  baslik    String
  metin     String
  durum     String   @default("BEKLIYOR") // BEKLIYOR | GONDERILDI | HATA
  hata      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Web Push aboneliği (tarayıcı bildirimleri)
model PushAbone {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  cihaz     String?
  createdAt DateTime @default(now())
}
