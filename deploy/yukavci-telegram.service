[Unit]
Description=Yuk Avcisi Telegram okuyucu (GramJS NewMessage)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yukavci
Group=yukavci
WorkingDirectory=/home/yukavci/apps/muhasebbe
Environment=NODE_ENV=production
# .env npm --env-file ile yüklenir; burada PORT gerekmez
ExecStart=/usr/bin/npm run telegram:daemon
Restart=always
RestartSec=5
# Log
StandardOutput=append:/home/yukavci/logs/telegram-daemon.log
StandardError=append:/home/yukavci/logs/telegram-daemon.log
# Güvenlik (gevşek — node/npm için)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
