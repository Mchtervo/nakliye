# Yük Avcısı — Europe/Istanbul (crontab'ta CRON_TZ)
# Kurulum: crontab -u yukavci deploy/crontab.yukavci
#
# Tüm işler _guvenli.sh üzerinden: +x kaybında Telegram uyarır,
# scripti her zaman /bin/bash ile çalıştırır (Permission denied yok).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Istanbul
YUKAVCI_REPO=/home/yukavci/muhasebbe
YUKAVCI_LOGDIR=/home/yukavci/logs
YUKAVCI_LOCKDIR=/home/yukavci/locks
GUVENLI=/home/yukavci/muhasebbe/deploy/cron/_guvenli.sh

# AI kuyruk — 5 dk (AI_KAPALI ise script atlar)
*/5 * * * * /bin/bash $GUVENLI ai-kuyruk.sh

# Sessiz saat birikimi — sabah 07:05 özet
5 7 * * * /bin/bash $GUVENLI sabah-ozet.sh

# Grup keşfi — günde 3: 08:00, 14:00, 20:00
0 8,14,20 * * * /bin/bash $GUVENLI grup-kesif.sh

# Grup temizlik onayı — her keşiften 15 dk sonra
15 8,14,20 * * * /bin/bash $GUVENLI grup-temizlik.sh

# Onaylı grup çıkışı — 30 dk; script günde max 3 + 30 dk ara
*/30 * * * * /bin/bash $GUVENLI grup-cik.sh

# Grup katılımı — 30 dk arayla; script günde max 8 + 30 dk ara
*/30 * * * * /bin/bash $GUVENLI grup-katil.sh

# Günlük rapor — 20:30 TR (keşif 20:00'dan sonra)
30 20 * * * /bin/bash $GUVENLI gunluk-rapor.sh

# Yedek — 03:15 TR
15 3 * * * /bin/bash $GUVENLI yedek.sh

# Disk doluluk — saatte 1 (%80+ Telegram uyarısı)
5 * * * * /bin/bash $GUVENLI disk.sh

# gonderenUserId geriye dönük — Pazartesi 06:10
10 6 * * 1 /bin/bash $GUVENLI uid-doldur.sh

# yuklegel.com firma+numara — 2 saatte 1 (AI maliyetini yakmamak için)
0 */2 * * * /bin/bash $GUVENLI yuklegel.sh

# Otomatik deploy — dakikada 1 (AUTO_DEPLOY=1 veya Ayarlar açık)
* * * * * /bin/bash $GUVENLI auto-deploy.sh
