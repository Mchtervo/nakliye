# Netlify / Vercel ortam değişkenleri (Dashboard → Environment variables)
# .env dosyasını ASLA GitHub'a koyma

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

DIRECT_URL=
DATABASE_URL=

APP_SIFRE=
SESSION_SECRET=

# --- AI modülleri (yük bulucu, fiş OCR, analiz) ---

# platform.openai.com > API keys. Boşsa AI ekranları çalışır ama içerik üretmez.
OPENAI_API_KEY=
# İsteğe bağlı model geçersiz kılma
# OPENAI_MODEL_HIZLI=gpt-5.6-luna
# OPENAI_MODEL_ANALIZ=gpt-5.6-terra

# Cron uçlarını (/api/ai/tara, /api/ai/gunluk-analiz) koruyan rastgele anahtar.
# Üretmek için: node -e "console.log(crypto.randomUUID())"
AI_CRON_SECRET=

# Sitenin genel adresi (bildirim linkleri için). Netlify'da URL zaten tanımlıdır.
SITE_URL=

# --- Telegram (yük bulucunun ana kaynağı + bildirim) ---

# @BotFather > /newbot ile alınan token
TELEGRAM_BOT_TOKEN=
# Webhook'u doğrulayan rastgele anahtar (kendin üret)
TELEGRAM_WEBHOOK_SECRET=

# --- Web Push (telefon bildirimi) ---
# npm run push:kur çıktısını buraya yapıştır
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seninmailin@ornek.com
