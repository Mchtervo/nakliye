# Netlify / Vercel ortam değişkenleri (Dashboard → Environment variables)
# .env dosyasını ASLA GitHub'a koyma

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

DIRECT_URL=
DATABASE_URL=

APP_SIFRE=
SESSION_SECRET=

# --- AI modülleri (yük bulucu, fiş OCR, analiz) ---

# platform.openai.com > API keys. Boşsa AI ekranları çalışır ama içerik üretmez.
OPENAI_API_KEY=
# Kill switch: true iken hiçbir OpenAI çağrısı / AI cron çalışmaz.
# Test modu (Ayarlar > 10 mesaj) bunu tek tur için yok sayar.
AI_KAPALI=true
# Günlük sert bütçe (USD). Aşılınca DB bayrağı iner + Telegram uyarısı.
AI_GUNLUK_LIMIT_USD=1
# max_output_tokens (reasoning de bu havuzdan). Varsayılan 1500.
# OPENAI_MAX_CIKTI=1500
# Timeout ms — timeout'ta retry YOK. Varsayılan 60000.
# OPENAI_TIMEOUT_MS=60000
# HamMesaj başına max AI denemesi. Varsayılan 2.
# AI_MAX_DENEME=2
# İsteğe bağlı model geçersiz kılma
# OPENAI_MODEL_HIZLI=gpt-5.6-luna
# OPENAI_MODEL_ANALIZ=gpt-5.6-terra

# Cron uçlarını (/api/ai/tara, /api/ai/gunluk-analiz) koruyan rastgele anahtar.
# Üretmek için: node -e "console.log(crypto.randomUUID())"
AI_CRON_SECRET=

# Sitenin genel adresi (bildirim linkleri için). Netlify'da URL zaten tanımlıdır.
SITE_URL=

# --- Telegram (yük bulucunun ana kaynağı + bildirim) ---

# @BotFather > /newbot ile alınan token
TELEGRAM_BOT_TOKEN=
# Webhook'u doğrulayan rastgele anahtar (kendin üret)
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram kendi hesabın (grupları otomatik bulup okumak için) ---
# my.telegram.org > API development tools sayfasından alınır.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# npm run telegram:oturum çıktısı. Hesabına tam erişim verir, gizli tut.
TELEGRAM_SESSION=

# --- Web Push (telefon bildirimi) ---
# npm run push:kur çıktısını buraya yapıştır
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seninmailin@ornek.com

# --- VPS otomatik deploy ---
# 1 = her zaman açık (panel/DB kapatsa bile). Kilitlenmeyi önler.
# AUTO_DEPLOY=1
